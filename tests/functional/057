#!/bin/bash

# Test md hot-plug and hot-unplug

. ./common

MD=3

_make_device 0 $((5 * 1024 ** 3))
_make_device 1 $((5 * 1024 ** 3))
_make_device 2 $((5 * 1024 ** 3))
_make_device 3 $((5 * 1024 ** 3))

for i in 0 1 2; do
	_start_sheep $i
done
_wait_for_sheep 3
_cluster_format
$DOG vdi create test 100M -P

_md_info

# plug during node event
_start_sheep 3
_wait_for_sheep 4
$DOG node md plug -f $(_md_disk 0 d3),$(_md_disk 0 d4)
_wait_for_sheep_recovery 0
_md_info
$DOG vdi check test
$DOG cluster info | _filter_cluster_info

# plug duplicate path
$DOG node md plug -f $(_md_disk 0 d3)
$DOG node recovery
_md_info

# unplug
$DOG node md unplug -f $(_md_disk 0 d0),$(_md_disk 0 d1)
_wait_for_sheep_recovery 0
_md_info
$DOG vdi check test
$DOG cluster info | _filter_cluster_info

# unplug invalid path
$DOG node md unplug -f $(_md_disk 0 d0)
$DOG node recovery
_md_info
$DOG cluster info | _filter_cluster_info

# check stale object purging
_list_stale_obj | _filter_store
