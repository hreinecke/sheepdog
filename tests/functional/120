#!/bin/bash

# Test 'dog acl add' and 'dog acl remove'

. ./common

err=0

for i in 0 1 2; do
    _start_sheep $i
done
_wait_for_sheep 3
_cluster_format -c 3

echo "= create an ACL and the VDIs to guard with it"
# the vid is needed to look at the ACL from the VDI side further down
acl_one=$($DOG acl create acl_one -v -r) || err=1
$DOG vdi create vdi_one 16M || err=1
$DOG vdi create vdi_two 16M || err=1
$DOG vdi create vdi_three 16M || err=1
$DOG vdi create vdi_free 16M || err=1

echo "= ACLs and VDIs are listed apart"
_vdi_list_json
_acl_list_json

echo "= add VDIs to the ACL"
$DOG acl add vdi acl_one vdi_one -v || err=1
$DOG acl add vdi acl_one vdi_two -v || err=1
$DOG acl add vdi acl_one vdi_three -v -j || err=1

echo "= the members carry the ACL in their inode now"
_vdi_list_json
_acl_list
_acl_list_json acl_one

echo "= a VDI can only be added once"
$DOG acl add vdi acl_one vdi_two && err=1

echo "= add needs an ACL and a VDI which both exist"
$DOG acl add vdi acl_one no_such_vdi && err=1
$DOG acl add vdi no_such_acl vdi_free && err=1
$DOG acl add vdi vdi_free vdi_one && err=1
# the usage text is not interesting here, keep the complaint only
$DOG acl add vdi acl_one 2>&1 >/dev/null && err=1

echo "= removing a VDI closes the hole it leaves behind"
$DOG acl remove vdi acl_one vdi_two -v -j || err=1

echo "= the removed VDI does not belong to an ACL anymore"
_vdi_list_json
_acl_list_json acl_one

echo "= the removal is persistent, so the VDI is appended when added again"
$DOG acl add vdi acl_one vdi_two -v -j || err=1

echo "= a VDI can only be removed once"
$DOG acl remove vdi acl_one vdi_two -v || err=1
$DOG acl remove vdi acl_one vdi_two && err=1

echo "= remove needs an ACL and a VDI which both exist"
$DOG acl remove vdi acl_one no_such_vdi && err=1
$DOG acl remove vdi no_such_acl vdi_one && err=1
$DOG acl remove vdi vdi_free vdi_one && err=1
$DOG acl remove vdi acl_one 2>&1 >/dev/null && err=1

echo "= a VDI can be moved to another ACL"
$DOG acl create acl_two -v -j || err=1
$DOG acl add vdi acl_two vdi_one && err=1
$DOG acl remove vdi acl_one vdi_one -v -j || err=1
$DOG acl add vdi acl_two vdi_one -v -j || err=1
_acl_list_json acl_one
_acl_list_json acl_two

echo "= an ACL can be emptied again"
$DOG acl remove vdi acl_one vdi_three -v -j || err=1
$DOG acl remove vdi acl_one vdi_three && err=1

echo "= a VDI is added and removed together with its snapshots"
$DOG vdi snapshot vdi_free -s snap || err=1
$DOG acl add vdi acl_one vdi_free -v || err=1
# only the head is mapped by the ACL, so check the snapshot from the VDI side
_acl_list_json acl_one
_vdi_list_json -A $((0x$acl_one))
$DOG acl remove vdi acl_one vdi_free -v || err=1
_vdi_list_json

echo "= an ACL still holding VDIs cannot be deleted"
$DOG acl delete acl_two && err=1

echo "= the VDIs outlive the ACL holding them"
$DOG acl remove vdi acl_two vdi_one -v -j || err=1
$DOG acl delete acl_two || err=1
$DOG acl delete acl_one || err=1
_acl_list_json
_vdi_list_json

exit $err
