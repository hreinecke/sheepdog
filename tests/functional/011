#!/bin/bash

# Test sheep booting on existing images mounted as loop device

. ./common

_make_device 0 $((2 * 1024 ** 3))
_make_device 1 $((4 * 1024 ** 3))
_make_device 2 $((8 * 1024 ** 3))

MD=1

for i in 0 1 2; do
    _start_sheep $i
done

_wait_for_sheep 3

echo check the number of vnodes
for i in 0 1 2; do
    _node_list -p 700$i
done

status=0
